{
  "name": "pok-deng",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @pok/server\" \"npm run dev -w @pok/client\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @pok/server",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:pok-layout": "node tests/pok-layout-browser.mjs",
    "test:pok-catch": "node tests/pok-catch-browser.mjs",
    "test:poker": "node tests/poker-browser.mjs",
    "test:poker-layout": "node tests/poker-layout-browser.mjs",
    "test:poker-pots": "node tests/poker-pots-browser.mjs",
    "test:poker-show": "node tests/poker-show-browser.mjs",
    "test:poker-high": "node tests/poker-high-browser.mjs",
    "test:poker-lifecycle": "node tests/poker-lifecycle-browser.mjs",
    "test:spyfall": "node tests/spyfall-browser.mjs",
    "test:spyfall-voting-layout": "node tests/spyfall-voting-layout-browser.mjs",
    "test:spyfall-settings": "node tests/spyfall-settings-browser.mjs",
    "test:oldmaid": "node tests/oldmaid-browser.mjs",
    "test:club-ui": "node tests/club-ui-browser.mjs",
    "test:dropdown-bots": "node tests/dropdown-bots-browser.mjs",
    "test:oldmaid-feedback": "node tests/oldmaid-feedback-browser.mjs",
    "test:desktop-ui": "node tests/desktop-ui-browser.mjs"
  },
  "devDependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.2",
    "playwright": "^1.64.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
